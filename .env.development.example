# ============================================================
# EventHub — Development Environment Variable Reference
#
# DO NOT put real secrets in this file.
# This file is committed to git as a reference only.
#
# To use: copy to .env, then fill in real dev/sandbox values.
# The .env file is gitignored and safe to hold real dev keys.
#
# VITE_* variables are baked into the Vite dev-server bundle.
# They are NOT secret — they appear in browser source.
# ============================================================

# ── Node ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── App URLs ────────────────────────────────────────────────
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:5001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:5001

# ── Database ─────────────────────────────────────────────────
# Use a dev database — never point local dev at production data.
DATABASE_URL=postgresql://user:password@localhost:5432/eventhub_dev

# ── Auth (JWT legacy) ────────────────────────────────────────
# Any long random string works locally.
# Generate: openssl rand -hex 64
JWT_SECRET=replace-with-any-long-random-string-for-local-dev
JWT_LEGACY_CUTOFF_EPOCH=1740787200

# ── Auth0 ────────────────────────────────────────────────────
# Use your DEV Auth0 tenant (dev-*.us.auth0.com).
AUTH0_DOMAIN=your-dev-auth0-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-auth0-api-identifier
VITE_AUTH0_DOMAIN=your-dev-auth0-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-dev-auth0-spa-client-id

# ── Stripe ───────────────────────────────────────────────────
# Use TEST keys (sk_test_* / pk_test_*) — never live keys locally.
# Get them from: Stripe Dashboard → (test mode) → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-test-publishable-key

# Webhook signing secrets come from the Stripe CLI, not the Dashboard.
# Run the CLI listener and it prints the whsec_* secret at startup.
#
# V1 events (bookings, payment intents):
#   stripe listen --forward-to http://localhost:5001/api/stripe/webhook
#
# V2 thin events (Connect account requirements/capabilities):
#   stripe listen \
#     --thin-events 'v2.core.account[requirements].updated,v2.core.account[configuration.recipient].capability_status_updated' \
#     --forward-thin-to http://localhost:5001/api/stripe/webhook/v2
#
# Both commands produce the same CLI signing secret — you can reuse it for both vars below.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-cli-signing-secret
STRIPE_WEBHOOK_SECRET_V2=whsec_your-stripe-cli-signing-secret

# ── Google OAuth + Calendar ──────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/google/oauth/callback
# Generate: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-key
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# ── Stream Chat ──────────────────────────────────────────────
STREAM_API_KEY=your-stream-chat-api-key
STREAM_API_SECRET=your-stream-chat-api-secret

# ── Mapbox ───────────────────────────────────────────────────
MAPBOX_PLACES_TOKEN=pk.your-mapbox-places-token
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token
MAPBOX_SECRET_TOKEN=sk.your-mapbox-secret-token
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ── Email (Resend) ───────────────────────────────────────────
# Resend has a sandbox mode — emails go to your verified address only.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=EventHub Dev <noreply@yourdomain.com>

# ── Object Storage (Cloudflare R2) ──────────────────────────
# Use a separate DEV bucket — not the production bucket.
# If unset, the server falls back to local disk (server/uploads/).
OBJECT_STORAGE_BUCKET=eventhub-dev
OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=your-dev-r2-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-dev-r2-secret-access-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://pub-your-dev-bucket.r2.dev
OBJECT_STORAGE_REGION=auto

# ── Firebase (frontend) ──────────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS=your-dev-email@example.com
