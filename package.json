{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "NODE_ENV=development tsx watch --env-file .env server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build && esbuild server/index.ts server/migrate.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild migrations/[0-9]*.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dispute": "node --import tsx ./tests/dispute-payout-eligibility.test.ts",
    "test:cancellation": "node --import tsx ./tests/cancellation-policy-refunds.test.ts",
    "test:uploads": "node --import tsx ./tests/upload-durability.test.ts",
    "test:payment-status": "node --import tsx ./tests/booking-payment-status-derivation.test.ts",
    "test:vendor-no-response": "node --import tsx ./tests/vendor-no-response-refund.test.ts",
    "test:deposit-refund": "node --import tsx ./tests/deposit-refund-split.test.ts",
    "test:refund-apportionment": "node --import tsx ./tests/refund-apportionment.test.ts",
    "test:payout-retry": "node --import tsx ./tests/payout-retry-eligibility.test.ts",
    "test:booking-conflict": "node --import tsx ./tests/booking-conflict-integrity.test.ts",
    "test:payment-init-side-effects": "node --import tsx ./tests/payment-init-side-effects.test.ts",
    "test:service-radius-fee": "node --import tsx ./tests/service-radius-fee.test.ts",
    "test:comp-publish": "node --import tsx ./tests/comp-publish-deadline.test.ts",
    "test:addon-pro-gating": "node --import tsx ./tests/addon-pro-gating.test.ts",
    "test:pricing-entitlements": "node --import tsx ./tests/pricing-model-entitlements.test.ts",
    "migrate": "tsx --env-file .env server/scripts/validate_migrations.ts && tsx --env-file .env server/migrate.ts",
    "validate:migrations": "tsx --env-file .env server/scripts/validate_migrations.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc"
  },
