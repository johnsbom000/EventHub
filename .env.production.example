# ============================================================
# EventHub — Production Environment Variable Reference
#
# DO NOT put real secrets in this file.
# This file is committed to git as a reference only.
#
# Where to set production secrets:
#   Railway → your service → Variables tab
#   (or your equivalent secrets manager / hosting dashboard)
#
# VITE_* variables are baked into the frontend bundle at build time.
# They must be set in your CI/CD build environment (not just runtime).
# They are NOT secret — they ship to every browser.
# ============================================================

# ── Node ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001

# ── Platform Fee Rates ───────────────────────────────────────
# Decimal fractions (0.08 = 8%). Change here and in Railway to adjust the cut.
VENDOR_FEE_RATE=0.08
CUSTOMER_FEE_RATE=0.05

# ── App URLs ────────────────────────────────────────────────
# Canonical public URL shown to users and used in redirect/email links.
APP_URL=https://eventhubglobal.com
# Server base URL (used internally for webhooks, OAuth callbacks, etc.)
SERVER_URL=https://eventhubrepo-production.up.railway.app
# Origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=https://eventhubglobal.com,https://www.eventhubglobal.com,https://eventhub-a5700.web.app,https://eventhub-a5700.firebaseapp.com
# Read by the Vite-built frontend at build time (not secret).
VITE_API_BASE_URL=https://eventhubrepo-production.up.railway.app

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string. Use a dedicated production database —
# never share the same DB between dev and production.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Auth (JWT legacy) ────────────────────────────────────────
# Long random secret for signing JWTs.
# Generate: openssl rand -hex 64
JWT_SECRET=replace-with-64-byte-hex-secret
JWT_LEGACY_CUTOFF_EPOCH=1740787200

# ── Auth0 ────────────────────────────────────────────────────
# Use your PRODUCTION Auth0 tenant — not the dev tenant.
AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-auth0-api-identifier
# Baked into the frontend bundle at build time (not secret).
VITE_AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# ── Stripe ───────────────────────────────────────────────────
# Use LIVE keys (sk_live_* / pk_live_*) in production.
# NEVER use test keys (sk_test_*) in production.
STRIPE_SECRET_KEY=sk_live_your-live-stripe-secret-key
# pk_live_* is not secret — it ships to the browser — but still use the live key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-live-stripe-publishable-key

# V1 webhook signing secret.
# Source: Stripe Dashboard → Developers → Webhooks →
#         your /api/stripe/webhook endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-v1-webhook-signing-secret

# V2 thin-event webhook signing secret (separate destination in Stripe Dashboard).
# Source: Stripe Dashboard → Developers → Webhooks →
#         your /api/stripe/webhook/v2 endpoint → Signing secret
# Setup: Events from "Connected accounts", Payload style "Thin",
#        Events: v2.core.account[requirements].updated
#                v2.core.account[configuration.recipient].capability_status_updated
STRIPE_WEBHOOK_SECRET_V2=whsec_your-v2-thin-event-signing-secret

# ── Google OAuth + Calendar ──────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://eventhubglobal.com/api/google/oauth/callback
# 32-byte hex key used to encrypt Google refresh tokens stored in the DB.
# Generate: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-key
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# ── Stream Chat ──────────────────────────────────────────────
STREAM_API_KEY=your-stream-chat-api-key
STREAM_API_SECRET=your-stream-chat-api-secret

# ── Mapbox ───────────────────────────────────────────────────
# pk.* tokens are not secret — they ship to the browser.
MAPBOX_PLACES_TOKEN=pk.your-mapbox-places-token
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token
# sk.* token IS secret — server-side only, never expose to the browser.
MAPBOX_SECRET_TOKEN=sk.your-mapbox-secret-token
# Not secret — baked into frontend build.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_live_your-resend-api-key
RESEND_FROM_EMAIL=Event Hub <no-reply@eventhubglobal.com>

# ── Object Storage (Cloudflare R2) ──────────────────────────
# Use a separate PRODUCTION bucket — not the dev bucket.
OBJECT_STORAGE_BUCKET=eventhub-prod
OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.eventhubglobal.com
OBJECT_STORAGE_REGION=auto

# ── Firebase (frontend) ──────────────────────────────────────
# These are not secret — they are baked into the frontend bundle.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS=your-admin@yourdomain.com
